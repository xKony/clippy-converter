<?xml version="1.0" encoding="utf-8"?>
<!--
  Clippy Converter per-user MSI (WiX v3 schema, built by the preinstalled
  WiX Toolset 3.14 on windows-latest runners).

  Preprocessor variables required from the caller (release.yml):
    $(var.Version)  - package version, sourced from Cargo.toml [package].version
    $(var.ExePath)  - absolute path to the built x64 clippy-converter.exe

  GUID policy:
    - UpgradeCode below is permanent; NEVER regenerate it, or upgrades break.
    - Component GUIDs are stable/hardcoded because each component has exactly
      one fixed resource in a fixed location.
    - Product/ProductCode is "*" (regenerated every build) so re-installing
      the same version replaces cleanly via MajorUpgrade below.

  Deliberately NOT done here (handled by the app itself):
    - Run-at-login autostart (app owns its HKCU Run key)
    - custom protocol handlers / services / drivers
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Clippy Converter"
    Language="1033"
    Version="$(var.Version)"
    Manufacturer="clippy-converter"
    UpgradeCode="{B62287E1-114A-4DD4-81BB-42F1531373AF}">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perUser"
      Description="Lightweight background unit and currency converter."
      Comments="Installs per user, no admin rights required." />

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- Per-user install root: %LocalAppData%\Programs\ClippyConverter -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="ClippyConverter">
            <Component Id="MainExecutable" Guid="{242A502B-0954-4FC5-B92F-6615EBC51CB2}" Win64="yes">
              <File
                Id="ClippyConverterExe"
                Name="clippy-converter.exe"
                Source="$(var.ExePath)"
                KeyPath="yes" />
              <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu folder + shortcut (HKCU-keyed so ICE38/ICE43 stay happy) -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppStartMenuDir" Name="Clippy Converter">
          <Component Id="StartMenuShortcut" Guid="{9CD98773-1D76-4124-B0A0-BCF4DD52BECD}">
            <Shortcut
              Id="StartMenuClippyConverter"
              Name="Clippy Converter"
              Description="Background unit and currency converter"
              Target="[INSTALLFOLDER]clippy-converter.exe"
              WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppStartMenuDir" Directory="AppStartMenuDir" On="uninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\clippy-converter\Clippy Converter"
              Name="InstallDir"
              Type="string"
              Value="[INSTALLFOLDER]"
              KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="Clippy Converter" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
